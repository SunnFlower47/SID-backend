APP_NAME="Sistem Informasi Desa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LANDLORD_DOMAIN=central.yourdomain.test
ADMIN_DOMAIN=admin.yourdomain.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# LOGGING SETTINGS
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DATABASE SETTINGS
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=YOUR_DB_DATABASE
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# CACHE SETTINGS - OPTIMIZED FOR FILE CACHE
CACHE_STORE=file
CACHE_PREFIX=laravel_cache

# SESSION SETTINGS - OPTIMIZED FOR FILE SESSION
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# QUEUE SETTINGS
QUEUE_CONNECTION=sync

# BROADCASTING SETTINGS
BROADCAST_CONNECTION=log

# STORAGE SETTINGS
# Options: 's3' (MinIO / Cloudflare R2 / AWS S3) or 'public' (Local Server storage/app/public)
FILESYSTEM_DISK=s3

# S3 / MinIO / CLOUDFLARE R2 SETTINGS
# Option A: Local MinIO (Docker)
AWS_ACCESS_KEY_ID=YOUR_MINIO_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_MINIO_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=YOUR_MINIO_BUCKET_NAME
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=

# Option B: Cloudflare R2 (Uncomment & fill if using R2 in production)
# AWS_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=YOUR_R2_BUCKET_NAME
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_URL=https://YOUR_R2_PUBLIC_URL

# REDIS SETTINGS (UNCOMMENT WHEN REDIS AVAILABLE)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# MEMCACHED SETTINGS
MEMCACHED_HOST=127.0.0.1

# MAIL SETTINGS
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SECURITY & API SETTINGS
API_KEY=YOUR_API_KEY_HERE
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3030,http://127.0.0.1:3000

# RECAPTCHA SETTINGS
RECAPTCHA_ENABLED=false
RECAPTCHA_V2_SITE_KEY=YOUR_RECAPTCHA_V2_SITE_KEY
RECAPTCHA_V2_SECRET_KEY=YOUR_RECAPTCHA_V2_SECRET_KEY
RECAPTCHA_V3_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY   
RECAPTCHA_V3_SECRET_KEY=YOUR_RECAPTCHA_V3_SECRET_KEY
RECAPTCHA_V3_MIN_SCORE=0.5

# VITE SETTINGS
VITE_APP_NAME="${APP_NAME}"

# OPTIMIZATION SETTINGS
OPCACHE_ENABLE=true

# PBB API global limit per minute across all tenants
PBB_API_GLOBAL_LIMIT=25

# Multi-Tenancy Shared Hosting Database configuration
# Set TENANT_DB_MANAGER to:
# - 'mysql' (default for VPS, automated database creation)
# - 'none' (for manual MySQL database creation on shared hosting)
# - 'sqlite' (for automated SQLite file-based databases on shared hosting)
TENANT_DB_MANAGER=mysql
TENANT_DB_CONNECTION=null
TENANT_DB_PREFIX=db_tenant_
